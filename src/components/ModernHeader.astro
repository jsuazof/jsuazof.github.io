---
const { activeSection } = Astro.props;
const nav = [
  { id: 'home', href: '/', es: 'Inicio', en: 'Home' },
  { id: 'projects', href: '/projects/', es: 'Proyectos', en: 'Projects' },
  { id: 'certificates', href: '/certificates/', es: 'Certificados', en: 'Certificates' },
];
---
<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/95 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Jorge Suazo - Inicio">
        <span class="grid h-10 w-10 place-items-center rounded-lg border border-blue-500/40 bg-blue-950 text-sm font-black tracking-wider text-blue-300">JSF</span>
        <div class="hidden sm:block">
          <div class="text-sm font-bold text-white">Jorge Suazo</div>
          <div class="text-xs text-slate-400">Cybersecurity &amp; Infrastructure</div>
        </div>
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a href={item.href} class={`rounded-md px-1 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-blue-500 ${activeSection === item.id ? 'text-blue-400' : 'text-slate-300 hover:text-white'}`} aria-current={activeSection === item.id ? 'page' : undefined}>
            <span data-lang="es">{item.es}</span><span data-lang="en" class="hidden">{item.en}</span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <button id="language-toggle" type="button" class="rounded-md border border-slate-700 px-2.5 py-1.5 text-xs font-bold text-slate-300 transition hover:border-blue-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Cambiar idioma">EN</button>
        <button id="theme-toggle" type="button" class="rounded-md p-2 text-slate-300 transition hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Cambiar tema">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
        <button id="mobile-menu-button" type="button" class="rounded-md p-2 text-slate-300 hover:bg-slate-800 md:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Abrir menú">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="hidden border-t border-slate-800 py-3 md:hidden" aria-label="Navegación móvil">
      <div class="flex flex-col gap-1">
        {nav.map((item) => (
          <a href={item.href} class={`rounded-md px-3 py-2 text-sm font-medium ${activeSection === item.id ? 'bg-blue-950 text-blue-300' : 'text-slate-300 hover:bg-slate-900'}`} aria-current={activeSection === item.id ? 'page' : undefined}><span data-lang="es">{item.es}</span><span data-lang="en" class="hidden">{item.en}</span></a>
        ))}
      </div>
    </nav>
  </div>
</header>
