---
const { activeSection } = Astro.props;
const nav = [
  { id: 'home', href: '/', es: 'Inicio', en: 'Home' },
  { id: 'projects', href: '/projects/', es: 'Proyectos', en: 'Projects' },
  { id: 'certificates', href: '/certificates/', es: 'Certificados', en: 'Certificates' },
];
---
<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/95 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Jorge Suazo - Inicio">
        <span class="grid h-10 w-10 place-items-center rounded-lg border border-blue-500/40 bg-blue-950 text-sm font-black tracking-wider text-blue-300">JSF</span>
        <div class="hidden sm:block">
          <div class="text-sm font-bold text-white">Jorge Suazo</div>
          <div class="text-xs text-slate-400">Cybersecurity &amp; Infrastructure</div>
        </div>
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a href={item.href} class={`rounded-md px-1 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-blue-500 ${activeSection === item.id ? 'text-blue-400' : 'text-slate-300 hover:text-white'}`} aria-current={activeSection === item.id ? 'page' : undefined}>
            <span data-lang="es">{item.es}</span><span data-lang="en" class="hidden">{item.en}</span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <button id="language-toggle" type="button" class="rounded-md border border-slate-700 px-2.5 py-1.5 text-xs font-bold text-slate-300 transition hover:border-blue-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Cambiar idioma">EN</button>
        <button id="theme-toggle" type="button" class="rounded-md p-2 text-slate-300 transition hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Cambiar tema" title="Cambiar tema">
          <svg id="theme-icon-moon" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg id="theme-icon-sun" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
        <button id="mobile-menu-button" type="button" class="rounded-md p-2 text-slate-300 hover:bg-slate-800 md:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Abrir menú">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="hidden border-t border-slate-800 py-3 md:hidden" aria-label="Navegación móvil">
      <div class="flex flex-col gap-1">
        {nav.map((item) => (
          <a href={item.href} class={`rounded-md px-3 py-2 text-sm font-medium ${activeSection === item.id ? 'bg-blue-950 text-blue-300' : 'text-slate-300 hover:bg-slate-900'}`} aria-current={activeSection === item.id ? 'page' : undefined}><span data-lang="es">{item.es}</span><span data-lang="en" class="hidden">{item.en}</span></a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  function syncPortfolioHeader() {
    const theme = localStorage.getItem('theme') || 'dark';
    const isDark = theme === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

    const moon = document.getElementById('theme-icon-moon');
    const sun = document.getElementById('theme-icon-sun');
    moon?.classList.toggle('hidden', isDark);
    sun?.classList.toggle('hidden', !isDark);

    const themeButton = document.getElementById('theme-toggle');
    themeButton?.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    themeButton?.setAttribute('title', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');

    const language = localStorage.getItem('portfolio-language') || 'es';
    document.documentElement.lang = language;
    document.querySelectorAll('[data-lang]').forEach((element) => {
      element.classList.toggle('hidden', element.dataset.lang !== language);
    });
    const languageButton = document.getElementById('language-toggle');
    if (languageButton) {
      languageButton.textContent = language === 'es' ? 'EN' : 'ES';
      languageButton.setAttribute('aria-label', language === 'es' ? 'Switch to English' : 'Cambiar a español');
    }
  }

  if (!window.__portfolioThemeClickRegistered) {
    window.__portfolioThemeClickRegistered = true;
    document.addEventListener('click', (event) => {
      const themeButton = event.target instanceof Element ? event.target.closest('#theme-toggle') : null;
      if (!themeButton) return;
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', nextTheme === 'dark');
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
      syncPortfolioHeader();
    });
  }

  if (!window.__portfolioLanguageClickRegistered) {
    window.__portfolioLanguageClickRegistered = true;
    document.addEventListener('click', (event) => {
      const languageButton = event.target instanceof Element ? event.target.closest('#language-toggle') : null;
      if (!languageButton) return;
      const nextLanguage = document.documentElement.lang === 'es' ? 'en' : 'es';
      document.documentElement.lang = nextLanguage;
      localStorage.setItem('portfolio-language', nextLanguage);
      syncPortfolioHeader();
    });
  }

  syncPortfolioHeader();
  document.addEventListener('DOMContentLoaded', syncPortfolioHeader);
  document.addEventListener('astro:page-load', syncPortfolioHeader);
</script>
