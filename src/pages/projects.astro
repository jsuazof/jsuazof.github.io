---
import ModernLayout from "../layouts/ModernLayout.astro";
import { getCollection } from "astro:content";
import sqlInteractiveImg from "../assets/images/projects/sqlinteractivo.webp";
import portfolioImg from "../assets/images/itemPreview.webp";

const allProjects = await getCollection("store");
const cloudProjects = allProjects.filter((project) =>
  project.data.badge === "HCL" ||
  /gcp|aws|cloud|terraform|infrastructure/i.test(project.data.title)
).sort((a, b) => String(b.data.updatedDate).localeCompare(String(a.data.updatedDate)));
const softwareProjects = allProjects.filter((project) => !cloudProjects.includes(project));
---

<ModernLayout title="Proyectos | Jorge Suazo" description="Proyectos de infraestructura, cloud, automatización, ciberseguridad y desarrollo de Jorge Suazo." activeSection="projects">
  <header class="mb-10">
    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"><span data-lang="es">Portafolio técnico</span><span data-lang="en" class="hidden">Technical portfolio</span></p>
    <h1 class="text-4xl font-bold text-white sm:text-5xl"><span data-lang="es">Proyectos</span><span data-lang="en" class="hidden">Projects</span></h1>
  </header>

  <section aria-labelledby="cyber-heading">
    <h2 id="cyber-heading" class="text-2xl font-bold text-white">Cybersecurity &amp; Infrastructure</h2>
    <p class="mt-2 max-w-3xl text-slate-400"><span data-lang="es">Esta sección será completada con proyectos verificables de seguridad de infraestructura, redes, análisis de logs y automatización. No se atribuyen laboratorios o resultados que no estén documentados en el repositorio.</span><span data-lang="en" class="hidden">This section will be completed with verifiable infrastructure security, networking, log analysis and automation projects. No laboratory work or results without repository documentation are inferred.</span></p>
  </section>

  <section class="mt-12" aria-labelledby="cloud-heading">
    <h2 id="cloud-heading" class="text-2xl font-bold text-white"><span data-lang="es">Cloud &amp; Infrastructure</span><span data-lang="en" class="hidden">Cloud &amp; Infrastructure</span></h2>
    <p class="mt-2 mb-6 text-slate-400"><span data-lang="es">Infraestructura como código, plataformas cloud y arquitecturas documentadas.</span><span data-lang="en" class="hidden">Infrastructure as code, cloud platforms and documented architectures.</span></p>
    <article class="mb-4 rounded-xl border border-slate-800 bg-slate-900/70 p-5 sm:flex sm:items-center sm:justify-between">
      <div class="max-w-3xl"><div class="mb-2 text-xs font-bold uppercase tracking-wider text-blue-400">AWS</div><h3 class="text-xl font-semibold text-white">Proyecto ABP - AWS</h3><p class="mt-2 text-sm leading-6 text-slate-400"><span data-lang="es">Marco teórico de Aprendizaje Basado en Problemas documentado durante formación AWS.</span><span data-lang="en" class="hidden">Problem-Based Learning framework documented during AWS training.</span></p></div>
      <a href="https://github.com/jsuazof/Proyecto-ABP" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-500 sm:mt-0"><span data-lang="es">Ver repositorio</span><span data-lang="en" class="hidden">View repository</span></a>
    </article>
    {cloudProjects.map((project) => (
      <article class="mb-4 rounded-xl border border-slate-800 bg-slate-900/70 p-5 sm:flex sm:items-center sm:justify-between">
        <div class="max-w-3xl"><div class="mb-2 text-xs font-bold uppercase tracking-wider text-blue-400">{project.data.badge || "Infrastructure"}</div><h3 class="text-xl font-semibold text-white">{project.data.title}</h3><p class="mt-2 text-sm leading-6 text-slate-400">{project.data.description}</p></div>
        {project.data.custom_link && <a href={project.data.custom_link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-500 sm:mt-0"><span data-lang="es">Ver repositorio</span><span data-lang="en" class="hidden">View repository</span></a>}
      </article>
    ))}
  </section>

  <section class="mt-12" aria-labelledby="software-heading">
    <h2 id="software-heading" class="text-2xl font-bold text-white"><span data-lang="es">Software Development</span><span data-lang="en" class="hidden">Software Development</span></h2>
    <p class="mt-2 mb-6 text-slate-400"><span data-lang="es">Conocimiento de desarrollo conservado como complemento técnico.</span><span data-lang="en" class="hidden">Development knowledge retained as complementary technical evidence.</span></p>
    <article class="mb-4 rounded-xl border border-slate-800 bg-slate-900/70 p-5 sm:flex sm:items-center sm:justify-between">
      <div class="max-w-3xl"><div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-400">SQL</div><h3 class="text-xl font-semibold text-white">SQL Interactivo</h3><p class="mt-2 text-sm leading-6 text-slate-400"><span data-lang="es">Sitio educativo para practicar consultas SQL con ejemplos interactivos.</span><span data-lang="en" class="hidden">Educational site for practicing SQL queries with interactive examples.</span></p></div>
      <a href="https://sqlinteractivo.desafiolatam.com/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-500 sm:mt-0"><span data-lang="es">Abrir proyecto</span><span data-lang="en" class="hidden">Open project</span></a>
    </article>
    <article class="mb-4 rounded-xl border border-slate-800 bg-slate-900/70 p-5 sm:flex sm:items-center sm:justify-between">
      <div class="max-w-3xl"><div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-400">Astro</div><h3 class="text-xl font-semibold text-white">Astro Portfolio</h3><p class="mt-2 text-sm leading-6 text-slate-400"><span data-lang="es">Portafolio personal desarrollado con Astro y TailwindCSS.</span><span data-lang="en" class="hidden">Personal portfolio developed with Astro and TailwindCSS.</span></p></div>
      <a href="https://github.com/jsuazof/jsuazof.github.io" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-500 sm:mt-0"><span data-lang="es">Ver repositorio</span><span data-lang="en" class="hidden">View repository</span></a>
    </article>
    {softwareProjects.map((project) => (
      <article class="mb-4 rounded-xl border border-slate-800 bg-slate-900/70 p-5 sm:flex sm:items-center sm:justify-between">
        <div class="max-w-3xl"><div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-400">{project.data.badge || "Software"}</div><h3 class="text-xl font-semibold text-white">{project.data.title}</h3><p class="mt-2 text-sm leading-6 text-slate-400">{project.data.description}</p></div>
        {project.data.custom_link && <a href={project.data.custom_link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-500 sm:mt-0"><span data-lang="es">Ver repositorio</span><span data-lang="en" class="hidden">View repository</span></a>}
      </article>
    ))}
  </section>
</ModernLayout>
