---
import ModernLayout from "../layouts/ModernLayout.astro";
import fs from "node:fs";

const cybersecurity = [
  { title: "Certificado Profesional de Google Cybersecurity", provider: "Google / Coursera", kind: "Verified Certificate — Approved", file: "/certificates/Google_CyberSecurity.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/specialization/HNG2AXLR9O2O" },
  { title: "Formación en Ciberseguridad", provider: "Nodo / Desafío Latam", kind: "Training Program — Approved", file: "" },
];
const cloud = [
  { title: "Oracle Cloud Infrastructure 2023 Certified Foundations Associate", provider: "Oracle", kind: "Verified Certification — Approved", file: "/certificates/OracleOCI2023Foundations.pdf", verificationUrl: "https://catalog-education.oracle.com/ords/certview/sharebadge?id=28D87126F09F999640C843A6ACFF0CD769E19A2FD6528FC17DEDA4B91CC9305C" },
  { title: "ARQUITECTURA CLOUD - ESPECIALIDAD", provider: "Talento Digital para Chile", kind: "Verified Badge — Approved", file: "/certificates/TalentoDigital_ArquitecturaCloudEspecialidad.pdf", verificationUrl: "https://www.acreditta.com/credential/fc317004-70d2-4a0e-bdcd-8c3357c9eb34?utm_source=linkedin_profile&resource_type=badge&resource=fc317004-70d2-4a0e-bdcd-8c3357c9eb34" },
  { title: "AWS Cloud Practitioner Essentials", provider: "AWS Training", kind: "Course Completion Certificate — Approved", file: "/certificates/AWS_CloudPractitioner.pdf" },
];
const automation = [
  { title: "Google IT Automation with Python", provider: "Google / Coursera", kind: "Professional Certificate — Approved", file: "/certificates/GoogleIT_AutomationWithPyton.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/specialization/5YC15BYBDJFJ" },
  { title: "Crash Course on Python", provider: "Google / Coursera", kind: "Course Completion Certificate — Approved", file: "/certificates/Coursera_google_python.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/records/2M3QEJC2KXH4" },
  { title: "Using Python to Interact with the Operating System", provider: "Google / Coursera", kind: "Course Completion Certificate — Approved", file: "/certificates/Coursera GB9VBPVHBF1B.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/records/GB9VBPVHBF1B" },
  { title: "Introduction to Git and GitHub", provider: "Google / Coursera", kind: "Course Completion Certificate — Approved", file: "/certificates/Coursera_IntroductionToGitAndGitHub.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/records/34IT1RYFMT2H" },
  { title: "Google AI Essentials", provider: "Google / Coursera", kind: "Professional Certificate — Approved", file: "/certificates/Coursera EPQJMDE5POLH.pdf", verificationUrl: "https://www.coursera.org/account/accomplishments/specialization/certificate/EPQJMDE5POLH" },
];
const software = [
  { title: "BOOTCAMP DESARROLLO DE APLICACIONES FULL STACK JAVA TRAINEE", provider: "Talento Digital para Chile", kind: "Verified Badge — Approved", file: "/certificates/TalentoDigital_FullStackJavaTrainee.pdf", verificationUrl: "https://www.acreditta.com/credential/10049489-6b3e-4622-8ad5-f25a7c575583?utm_source=linkedin_profile&resource_type=badge&resource=10049489-6b3e-4622-8ad5-f25a7c575583" },
  { title: "Bootcamp de GitHub Actions", provider: "Microsoft", kind: "Course Completion Certificate — Approved", file: "/certificates/Certificado - Bootcamp de GitHub Actions.pdf" },
  { title: "CÓDIGOFEST 2025", provider: "Microsoft", kind: "Course / Event Certificate — Approved", file: "/certificates/Certificado - CÓDIGOFEST 2025 powered by Microsoft.pdf" },
  { title: "Emprendimiento y Gestión Digital", provider: "IPCHILE", kind: "Diploma Certificate — Approved", file: "/certificates/Diplomado - Certificado IPCHILE.pdf" },
  { title: "Scrum Fundamentals Certified (SFC)", provider: "VMEdu.com", kind: "Verified Certification — Approved", file: "/certificates/Scrum_Fundamentals_Certified.pdf", verificationUrl: "https://www.scrumstudy.com/certification/verify?type=SFC&number=1057544" },
];
const awsModules = [
  ["AWS Foundations: Getting Started with the AWS Cloud Essentials", "AWS_Foundations.pdf"], ["AWS Compute Services Overview", "AWS_ComputeServicesOverview.pdf"], ["Amazon Elastic Block Store", "AWS_AmazonElasticBlockStore.pdf"], ["Amazon RDS Service Primer", "AWS_AmazonRDS_ServicePrimer.pdf"], ["Amazon Simple Storage Service", "AWS_AmazonSimpleStorageService.pdf"], ["Amazon Transcribe Getting Started", "AWS_AmazonTranscribeGetting.pdf"], ["Architecting Serverless Solutions", "AWS_ArchitectingServerless.pdf"], ["AWS Backup Primer", "AWS_BackupPrimer.pdf"], ["AWS Basics of Managed Services", "AWS_BasicsManagedServices.pdf"], ["AWS Billing and Cost Management", "AWS_Billing_and_Cost.pdf"], ["AWS Command Line Interface", "AWS_Command_Line_Interface.pdf"], ["AWS Database Offerings", "AWS_DatabaseOfferings.pdf"], ["AWS Identity and Access Management", "AWS_IdentityAndAccessManagement.pdf"], ["AWS Introduction to Auto Scaling", "AWS_IntroductionToAutoScaling.pdf"], ["AWS Introduction to Management Console", "AWS_IntroductionToManagementConsole.pdf"], ["AWS Shared Responsibility Model", "AWS_SharedResponsibility.pdf"], ["AWS Subnets, Gateways & Route Tables", "AWS_SubnetsGateways_RouteTablesExplained.pdf"], ["AWS Technical Essentials", "AWS_TechnicalEssentials.pdf"], ["AWS Cloud Operating Models", "AWS_WorksWithinCloudOperatingModels.pdf"]
];
const certificateGroups = [cybersecurity, cloud, automation, software];
const missingCertificateFiles = certificateGroups
  .flat()
  .map((item) => item.file)
  .filter((file) => file && !fs.existsSync(`public${file}`));
const missingAwsModuleFiles = awsModules
  .map(([, file]) => `/certificates/${file}`)
  .filter((file) => !fs.existsSync(`public${file}`));
const allMissingCertificateFiles = [...missingCertificateFiles, ...missingAwsModuleFiles];

if (allMissingCertificateFiles.length) {
  throw new Error(`Missing certificate PDF evidence: ${allMissingCertificateFiles.join(", ")}`);
}
---
<ModernLayout title="Certificados | Jorge Suazo" description="Formación y certificados en ciberseguridad, cloud computing, infraestructura, automatización y desarrollo." activeSection="certificates">
  <header class="mb-10">
    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"><span data-lang="es">Formación profesional</span><span data-lang="en" class="hidden">Professional training</span></p>
    <h1 class="text-4xl font-bold text-white sm:text-5xl"><span data-lang="es">Certificados y formación</span><span data-lang="en" class="hidden">Certificates & training</span></h1>
    <p class="mt-4 max-w-3xl text-slate-400"><span data-lang="es">Todos los certificados y programas de formación publicados están aprobados y son válidos. Los cursos y badges se identifican por su nivel real sin alterar su estado aprobado.</span><span data-lang="en" class="hidden">All published certificates and training programs are approved and valid. Courses and badges are identified at their actual level without changing their approved status.</span></p>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    {[
      ["Cybersecurity", cybersecurity, "es-ciberseguridad"],
      ["Cloud Computing", cloud, "cloud-computing"],
      ["Infrastructure & Automation", automation, "infraestructura-automatizacion"],
      ["Software Development", software, "software-development"]
    ].map(([title, items, id]) => (
      <section id={String(id)} class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="mb-5 text-xl font-bold text-white">{title}</h2>
        <div class="space-y-3">
          {(items as Array<{ title: string; provider: string; kind: string; file: string; verificationUrl?: string }>).map((item) => (
            <article class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
              <div class="flex items-start justify-between gap-4">
                <div><h3 class="font-semibold text-slate-100">{item.title}</h3><p class="mt-1 text-sm text-slate-400">{item.provider}</p></div>
                <div class="flex shrink-0 gap-3">
                  {item.file && <a href={item.file} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-blue-400 hover:text-blue-300"><span data-lang="es">Ver PDF</span><span data-lang="en" class="hidden">View PDF</span></a>}
                  {item.verificationUrl && <a href={item.verificationUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-blue-400 hover:text-blue-300"><span data-lang="es">Ver badge</span><span data-lang="en" class="hidden">View badge</span></a>}
                </div>
              </div>
              <p class="mt-3 inline-block rounded-full border border-blue-900 px-2.5 py-1 text-xs font-medium text-blue-300">{item.kind}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
    <h2 class="text-xl font-bold text-white">AWS — <span data-lang="es">Certificados de cursos completados</span><span data-lang="en" class="hidden">Course completion certificates</span></h2>
    <p class="mt-2 text-sm text-slate-400"><span data-lang="es">Cursos, módulos y fundamentos AWS. No se presentan como certificaciones profesionales de AWS.</span><span data-lang="en" class="hidden">AWS courses, modules and fundamentals. Not presented as AWS professional certifications.</span></p>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {awsModules.map(([title, file]) => <a href={`/certificates/${file}`} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 text-sm font-medium text-slate-200 transition hover:border-blue-500 hover:text-blue-300"><span class="mb-2 block text-xs uppercase text-slate-500"><span data-lang="es">Finalizado — Aprobado</span><span data-lang="en" class="hidden">Completed — Approved</span></span>{title}</a>)}
    </div>
  </section>
</ModernLayout>
