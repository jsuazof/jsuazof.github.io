---
import ModernLayout from "../layouts/ModernLayout.astro";

const cybersecurity = [
  { title: "Formación en Ciberseguridad", provider: "Nodo / Desafío Latam", kind: "Training Program — In Progress", file: "" },
];
const cloud = [
  { title: "Oracle Cloud Infrastructure Certification", provider: "Oracle", kind: "Cloud Certification / Training — status to verify", file: "" },
  { title: "AWS Cloud Practitioner Essentials", provider: "AWS Training", kind: "Course Completion Certificate / Training", file: "/certificates/AWS_CloudPractitioner.pdf" },
  { title: "Talento Digital Cloud Architect Fundamentals", provider: "Talento Digital", kind: "Training Program / Course Completion", file: "" },
];
const automation = [
  { title: "Google IT Automation with Python", provider: "Google / Coursera", kind: "Course Completion Certificate", file: "/certificates/Coursera_google_python.pdf" },
];
const software = [
  { title: "Talento Digital Full Stack Java", provider: "Talento Digital", kind: "Training Program / Course Completion", file: "" },
  { title: "Bootcamp de GitHub Actions", provider: "Microsoft", kind: "Course Completion Certificate", file: "/certificates/Certificado - Bootcamp de GitHub Actions.pdf" },
  { title: "CÓDIGOFEST 2025", provider: "Microsoft", kind: "Course / Event Certificate", file: "/certificates/Certificado - CÓDIGOFEST 2025 powered by Microsoft.pdf" },
];
const awsModules = [
  ["Amazon Elastic Block Store", "AWS_AmazonElasticBlockStore.pdf"], ["Amazon RDS Service Primer", "AWS_AmazonRDS_ServicePrimer.pdf"], ["Amazon Simple Storage Service", "AWS_AmazonSimpleStorageService.pdf"], ["Amazon Transcribe Getting Started", "AWS_AmazonTranscribeGetting.pdf"], ["Architecting Serverless Solutions", "AWS_ArchitectingServerless.pdf"], ["AWS Backup Primer", "AWS_BackupPrimer.pdf"], ["AWS Basics of Managed Services", "AWS_BasicsManagedServices.pdf"], ["AWS Billing and Cost Management", "AWS_Billing_and_Cost.pdf"], ["AWS Command Line Interface", "AWS_Command_Line_Interface.pdf"], ["AWS Database Offerings", "AWS_DatabaseOfferings.pdf"], ["AWS Identity and Access Management", "AWS_IdentityAndAccessManagement.pdf"], ["AWS Introduction to Auto Scaling", "AWS_IntroductionToAutoScaling.pdf"], ["AWS Introduction to Management Console", "AWS_IntroductionToManagementConsole.pdf"], ["AWS Shared Responsibility Model", "AWS_SharedResponsibility.pdf"], ["AWS Subnets, Gateways & Route Tables", "AWS_SubnetsGateways_RouteTablesExplained.pdf"], ["AWS Technical Essentials", "AWS_TechnicalEssentials.pdf"], ["AWS Cloud Operating Models", "AWS_WorksWithinCloudOperatingModels.pdf"]
];
const professional = [
  { title: "Google Cybersecurity Professional Certificate", provider: "Google / Coursera", kind: "Professional Certificate", file: "/certificates/Google_CyberSecurity.pdf" },
  { title: "IPCHILE Professional Certificate", provider: "IPCHILE", kind: "Course Completion Certificate", file: "/certificates/Diplomado_Certificado_IPCHILE.pdf" },
  { title: "IPCHILE Module Diploma", provider: "IPCHILE", kind: "Course Completion Certificate", file: "/certificates/Diplomado_Diploma_modulo_IPCHILE.pdf" },
];
---
<ModernLayout title="Certificados | Jorge Suazo" description="Formación y certificados en ciberseguridad, cloud computing, infraestructura, automatización y desarrollo." activeSection="certificates">
  <header class="mb-10">
    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"><span data-lang="es">Formación profesional</span><span data-lang="en" class="hidden">Professional training</span></p>
    <h1 class="text-4xl font-bold text-white sm:text-5xl"><span data-lang="es">Certificados y formación</span><span data-lang="en" class="hidden">Certificates & training</span></h1>
    <p class="mt-4 max-w-3xl text-slate-400"><span data-lang="es">Los cursos y badges se presentan como formación completada, nunca como certificaciones profesionales oficiales cuando la evidencia disponible corresponde a un curso o módulo.</span><span data-lang="en" class="hidden">Courses and badges are presented as completed training and are not described as official professional certifications unless that status is evidenced.</span></p>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    {[
      ["Cybersecurity", cybersecurity, "es-ciberseguridad"],
      ["Cloud Computing", cloud, "cloud-computing"],
      ["Infrastructure & Automation", automation, "infraestructura-automatizacion"],
      ["Software Development", software, "software-development"]
    ].map(([title, items, id]) => (
      <section id={String(id)} class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="mb-5 text-xl font-bold text-white">{title}</h2>
        <div class="space-y-3">
          {(items as typeof cybersecurity).map((item) => (
            <article class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
              <div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold text-slate-100">{item.title}</h3><p class="mt-1 text-sm text-slate-400">{item.provider}</p></div>{item.file && <a href={item.file} target="_blank" rel="noopener noreferrer" class="shrink-0 text-sm font-semibold text-blue-400 hover:text-blue-300"><span data-lang="es">Ver PDF</span><span data-lang="en" class="hidden">View PDF</span></a>}</div>
              <p class="mt-3 inline-block rounded-full border border-blue-900 px-2.5 py-1 text-xs font-medium text-blue-300">{item.kind}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
    <h2 class="text-xl font-bold text-white"><span data-lang="es">Certificaciones profesionales y certificados de cursos</span><span data-lang="en" class="hidden">Professional &amp; course completion certificates</span></h2>
    <div class="mt-5 grid gap-3 md:grid-cols-2">
      {professional.map((item) => <article class="rounded-xl border border-slate-800 bg-slate-950/60 p-4"><div class="flex justify-between gap-3"><div><h3 class="font-semibold text-slate-100">{item.title}</h3><p class="mt-1 text-sm text-slate-400">{item.provider}</p></div>{item.file && <a href={item.file} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-blue-400">PDF</a>}</div><p class="mt-3 text-xs text-blue-300">{item.kind}</p></article>)}
    </div>
  </section>

  <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
    <h2 class="text-xl font-bold text-white">AWS — <span data-lang="es">Certificados de cursos completados</span><span data-lang="en" class="hidden">Course completion certificates</span></h2>
    <p class="mt-2 text-sm text-slate-400"><span data-lang="es">Cursos, módulos y fundamentos AWS. No se presentan como certificaciones profesionales de AWS.</span><span data-lang="en" class="hidden">AWS courses, modules and fundamentals. Not presented as AWS professional certifications.</span></p>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {awsModules.map(([title, file]) => <a href={`/certificates/${file}`} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 text-sm font-medium text-slate-200 transition hover:border-blue-500 hover:text-blue-300"><span class="mb-2 block text-xs uppercase text-slate-500">Course Completion</span>{title}</a>)}
    </div>
  </section>
</ModernLayout>
